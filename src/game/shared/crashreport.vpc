//-----------------------------------------------------------------------------
//	CRASHREPORT.VPC
//-----------------------------------------------------------------------------

$Configuration
{
  $Compiler
  {
    $AdditionalIncludeDirectories "$BASE;$SRCDIR\thirdparty\sentry_native\include"
  }
}

$Project
{
  $Folder "Link Libraries"
  {
    $ImpLibexternal "$SRCDIR\thirdparty\sentry_native\lib\sentry" [$WINDOWS]
    $ImpLibexternal "$SRCDIR/thirdparty/sentry_native/lib/libsentry" [$LINUXALL]
  }
    
  $Folder "Source Files"
  {
    $Folder "Crash Reporter"
    {
      $File "$SRCDIR\game\shared\crashreport\crashreport.h"
      // Not using precompiled header cbase.h
      $File "$SRCDIR\game\shared\crashreport\crashreport.cpp"
      {
        $Configuration
        {
          $Compiler
          {
            $Create/UsePrecompiledHeader	"Not Using Precompiled Headers"
          }
        }
      }
    }
  }
}